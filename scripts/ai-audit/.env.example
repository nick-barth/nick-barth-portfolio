# Copy these into .env in the repo root (already gitignored). Any engine without a key is skipped.
OPENAI_API_KEY=        # ChatGPT — platform.openai.com
PERPLEXITY_API_KEY=    # Perplexity — console.perplexity.ai (needs paid credit)
GEMINI_API_KEY=        # Gemini — aistudio.google.com/apikey

# Optional model overrides
# OPENAI_MODEL=gpt-5
# PERPLEXITY_EFFORT=fast   # Agent API effort tier; "fast" replaces the old sonar model
# GEMINI_MODEL=gemini-flash-latest   # alias for the current Flash model
